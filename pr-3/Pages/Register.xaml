<Page x:Class="pr_3.Pages.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr_3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Register" 
      Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="260"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Создание новой учетной записи" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Введите имя пользователя:"/>
            <TextBox x:Name="txtFirstName"/>

            <TextBlock Text="Введите фамилию пользователя:"/>
            <TextBox x:Name="txtLastName"/>

            <TextBlock Text="Введите логин пользователя:"/>
            <TextBox x:Name="txtLogin"/>

            <TextBlock Text="Введите пароль пользователя:"/>
            <PasswordBox x:Name="psbPassword"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button Content="Зарегистрировать" Click="btnRegister_Click"/>
                <Button Content="Назад" Click="btnBack_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
