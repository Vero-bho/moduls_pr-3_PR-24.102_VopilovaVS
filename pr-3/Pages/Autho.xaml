<Page x:Class="pr_3.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pr_3.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Autho"
      Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtLogin"/>

            <TextBlock Text="Пароль:"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="psbPassword" Grid.Column="0"
                             PasswordChanged="psbPassword_PasswordChanged"/>
                <TextBox x:Name="txtPasswordVisible" Grid.Column="0"
                         Visibility="Collapsed"
                         TextChanged="txtPasswordVisible_TextChanged"/>
                <CheckBox x:Name="chkShowPassword" Grid.Column="1"
                          Content="Показать"
                          Margin="8,0,0,0"
                          VerticalAlignment="Center"
                          Checked="chkShowPassword_Checked"
                          Unchecked="chkShowPassword_Unchecked"/>
            </Grid>

            <TextBlock x:Name="txtBlockCaptcha" Text="Капча:" Visibility="Collapsed"/>
            <Grid Visibility="Collapsed" x:Name="gridCaptcha">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtBoxCaptcha" Grid.Column="0"/>
                <TextBlock x:Name="tblCaptcha" Grid.Column="1"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="Bold"/>
            </Grid>

            <TextBlock x:Name="txtAttemptsInfo" Foreground="DarkRed"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>

            <TextBlock x:Name="txtLockoutInfo" Foreground="Red" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,8,0,0"
                       Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="80">
                <Button x:Name="btnEnterGuests" Margin="5,15,5,5"
                        Content="Войти как гость" Click="btnEnterGuests_Click"/>
                <Button x:Name="btnEnter" Margin="5,15,5,5"
                        Content="Войти" Click="btnEnter_Click"/>
                <Button x:Name="btnRegisterPage" Margin="5,15,5,5"
                        Content="Регистрация" Click="btnRegisterPage_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>